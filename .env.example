# ======================
# Backend API Configuration
# ======================
VITE_API_BASE_URL=http://localhost:4000/api/v1
PUBLIC_API_URL=http://localhost:4000/api/v1
STORAGE_DIRECTORY=./uploads

# ======================
# Feature Flags
# ======================
# Global toggle: 'true' to use NestJS backend, 'false' to use Supabase
VITE_USE_NESTJS_API=false

# Per-module toggles (optional, overrides global flag)
# Set to 'true' or 'false' to override, leave empty to use global
VITE_NESTJS_AUTH=
VITE_NESTJS_FINANCE=
VITE_NESTJS_TEAM_PAYMENTS=
VITE_NESTJS_STORAGE=
VITE_NESTJS_CALENDAR=
VITE_NESTJS_PROJECTS=
VITE_NESTJS_CLIENTS=
VITE_NESTJS_TEAM_MEMBERS=
VITE_NESTJS_PACKAGES=
VITE_NESTJS_ADDONS=
VITE_NESTJS_LEADS=
VITE_NESTJS_GALLERIES=
VITE_NESTJS_PROFILE=
VITE_NESTJS_CLIENT_FEEDBACK=
VITE_NESTJS_PROFILE_SETTINGS=

# ======================
# Supabase (Legacy - still needed during transition)
# ======================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ======================
# Other Services
# ======================
VITE_GEMINI_API_KEY=
VITE_VAPID_PUBLIC_KEY=
